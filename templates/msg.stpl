<div class="card" style="max-width:440px; margin:80px auto 0; text-align:center;">
  <div style="font-size:42px; margin-bottom:12px;"><%= icon %></div>
  <h2 style="margin:0 0 8px;"><%= title %></h2>
  <p class="faint small" style="margin:0 0 20px;"><%= message %></p>
  <a class="btn" href="<%= base %>/">Back to start</a>
</div>
<div class="card">
  <div class="section-title">Settings</div>
  <% if let Some(e) = err { %><div class="alert alert-error"><%= e %></div><% } %>
  <% if let Some(m) = ok { %><div class="alert alert-ok"><%= m %></div><% } %>
  <form method="post" action="/admin/settings" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
    <div class="field" style="flex:1; min-width:220px; margin:0;">
      <label>Max file size (MB)</label>
      <input type="number" name="max_file_size_mb" value="<%= max_size_mb %>" min="1" required>
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
  </form>
</div>

<div class="card">
  <div class="section-title">Users</div>
  <% if users.is_empty() { %>
    <div class="empty">No users.</div>
  <% } else { %>
  <table class="table">
    <thead><tr><th>Username</th><th>Role</th><th>Files</th><th class="actions">Actions</th></tr></thead>
    <tbody>
      <% for u in users { %>
      <tr>
        <td class="name"><%= u.name %></td>
        <td><span class="badge <%= u.badge_class %>"><%= u.role %></span></td>
        <td class="dim"><%= u.file_count %></td>
        <td class="actions">
          <form method="post" action="/admin/users/<%= u.id %>/password" style="display:inline-flex; gap:6px; align-items:center;">
            <input class="inline-input" type="password" name="password" placeholder="New password" required minlength="6" style="width:140px; padding:6px 10px;">
            <button class="btn btn-sm btn-ghost" type="submit">Reset</button>
          </form>
          <% if !u.is_self { %>
          <form method="post" action="/admin/users/<%= u.id %>/delete" style="display:inline;">
            <button class="btn btn-sm btn-danger" type="submit">Delete</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>
  <hr class="divider">
  <div class="section-title">Create user</div>
  <form method="post" action="/admin/users" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
    <div class="field" style="flex:1; min-width:160px; margin:0;">
      <label>Username</label>
      <input class="inline-input" type="text" name="username" placeholder="username" required>
    </div>
    <div class="field" style="flex:1; min-width:160px; margin:0;">
      <label>Password</label>
      <input class="inline-input" type="password" name="password" placeholder="password" required minlength="6">
    </div>
    <button class="btn btn-primary" type="submit">Create</button>
  </form>
</div>

<div class="card">
  <div class="section-title">All files</div>
  <% if files.is_empty() { %>
    <div class="empty">No files.</div>
  <% } else { %>
  <table class="table">
    <thead><tr><th>Name</th><th>Owner</th><th>Size</th><th>Expires</th><th class="actions">Actions</th></tr></thead>
    <tbody>
      <% for f in files { %>
      <tr>
        <td class="name"><%= f.name %></td>
        <td class="dim"><%= f.owner %></td>
        <td class="dim"><%= f.size %></td>
        <td>
          <% if f.expired { %>
            <span class="pill danger">expired</span>
          <% } else { %>
            <span class="<%= f.expiry_class %>"><span class="window"><%= f.window %></span><span class="remaining">· <%= f.remaining %></span></span>
          <% } %>
        </td>
        <td class="actions">
          <button class="btn btn-sm btn-ghost" type="button" onclick="copyLink('<%= f.url %>', this)">Copy link</button>
          <form method="post" action="/admin/files/<%= f.id %>/delete" style="display:inline;">
            <button class="btn btn-sm btn-danger" type="submit">Delete</button>
          </form>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>
</div>

<script>
function copyLink(url, btn) {
  navigator.clipboard.writeText(url).then(function () {
    btn.textContent = "Copied!";
    setTimeout(function () { btn.textContent = "Copy link"; }, 1500);
  });
}
</script>